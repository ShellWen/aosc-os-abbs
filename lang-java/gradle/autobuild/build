abinfo "Creating version.txt ..."
echo $VER > "$SRCDIR"/version.txt

abinfo "Building gradle ..."
install -dv "$SRCDIR"/temp
./gradlew installAll -Pgradle_installpath="$SRCDIR"/temp -PfinalRelease=true

abinfo "Creating directories ..."
install -dv "$PKGDIR"/usr/{bin,share,lib}

abinfo "Remove the bat file ..."
rm "$SRCDIR"/temp/bin/gradle.bat

abinfo "Copying libraries ..."
install -dv "$PKGDIR"/usr/lib/gradle/
cp -rv "$SRCDIR"/temp/{bin,lib}/ "$PKGDIR"/usr/lib/gradle/

abinfo "Copying documentations ..."
install -dv "$PKGDIR"/usr/share/doc/
cp -rv "$SRCDIR"/temp/docs "$PKGDIR"/usr/share/doc/gradle

abinfo "Making symlinks ..."
ln -sv ../lib/gradle/bin/gradle "$PKGDIR"/usr/bin/gradle
chmod -v a+x "$PKGDIR"/usr/lib/gradle/bin/gradle
