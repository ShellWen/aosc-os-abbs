PKGNAME=cosmic-settings-daemon
PKGSEC=COSMIC
PKGDEP="acpid gcc-runtime geoclue2 libinput linux-pam playerctl pop-gtk-theme \
        pulseaudio systemd"
BUILDDEP="rustc llvm just"
PKGDES="Settings daemon for COSMIC Desktop Environment"
USECLANG=1
ABTYPE=rust

