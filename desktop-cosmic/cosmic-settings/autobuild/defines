PKGNAME=cosmic-settings
PKGSEC=COSMIC
PKGDEP="adw-gtk3 accountsservice cosmic-bg cosmic-panel cosmic-randr \
        cosmic-settings-daemon fontconfig freetype gcc-runtime gettext glibc \
        iso-codes libinput libxkbcommon network-manager-applet pipewire \
        pulseaudio systemd xkeyboard-config tuned wireguard \
        networkmanager-openvpn"
BUILDDEP="rustc llvm just"
PKGDES="Settings app for COSMIC Desktop Environment"
USECLANG=1
ABTYPE=rust

# FIXME: ld.lld is not yet available for loongson3.
# ld.lld: error: relocation R_MIPS_64 cannot be used against local symbol; 
# recompile with -fPIC
NOLTO__LOONGSON3=1
